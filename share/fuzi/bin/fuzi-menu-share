#!/bin/bash

if (($# == 0)); then
  echo "Usage: fuzi-menu-share [clipboard|file|folder]" >&2
  exit 1
fi

MODE="$1"
shift

if [[ $MODE == "clipboard" ]]; then
  TEMP_FILE=$(mktemp --suffix=.txt)

  if ! wl-paste >"$TEMP_FILE"; then
    rm -f "$TEMP_FILE"
    echo "Не удалось получить содержимое буфера обмена" >&2
    exit 1
  fi

  FILE_ARRAY=("$TEMP_FILE")
elif (($# > 0)); then
  FILE_ARRAY=("$@")
else
  if [[ $MODE == "folder" ]]; then
    # Pick a single folder from home directory
    picked=$(find "$HOME" -type d 2>/dev/null | fzf)
  else
    # Pick one or more files from home directory
    picked=$(find "$HOME" -type f 2>/dev/null | fzf --multi)
  fi

  [[ -z $picked ]] && exit 0

  readarray -t FILE_ARRAY <<<"$picked"
fi

((${#FILE_ARRAY[@]} > 0)) || exit 0

if ! command -v setsid >/dev/null 2>&1; then
  echo "setsid не найден. Обычно он входит в util-linux." >&2
  exit 1
fi

setsid localsend --headless send "${FILE_ARRAY[@]}" >/dev/null 2>&1 </dev/null &

exit 0
