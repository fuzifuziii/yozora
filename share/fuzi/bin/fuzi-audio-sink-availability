#!/bin/bash

set -u

# Report physical sinks as available. The panel uses this to hide stale
# devices while keeping the current default sink visible.
pactl list sinks short 2>/dev/null | while read -r index name _rest; do
  [ -n "$name" ] || continue
  state="$(pactl get-sink-state "$name" 2>/dev/null || true)"
  if [ "$state" = "SUSPENDED" ]; then
    printf '%s\t0\n' "$name"
  else
    printf '%s\t1\n' "$name"
  fi
done
