#!/bin/bash

state_file="$HOME/.local/share/fuzi/notifications.json"

if grep -q '"dnd"[[:space:]]*:[[:space:]]*true' "$state_file" 2>/dev/null; then
  fuzi-shell notifications toggleDnd 2>/dev/null || true
  notify-send -u low "Notifications enabled"
else
  notify-send -u low "Notifications silenced"
  fuzi-shell notifications toggleDnd 2>/dev/null || true
fi

fuzi-shell -q omarchy.indicators refresh
