#!/usr/bin/python3

import os
import subprocess
import sys
import tempfile

CONFIG = "/etc/mihomo/config.yaml"


def write_config(lines):
    os.makedirs("/etc/mihomo/providers", mode=0o750, exist_ok=True)
    os.chown("/etc/mihomo/providers", 989, 988)
    fd, temp = tempfile.mkstemp(prefix="mihomo-config-", dir="/etc/mihomo")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            stream.writelines(lines)
        os.chown(temp, 0, 988)
        os.chmod(temp, 0o640)
        os.replace(temp, CONFIG)
    finally:
        if os.path.exists(temp):
            os.unlink(temp)


def default_config(url):
    return [
        "mixed-port: 7890\n",
        "external-controller: 127.0.0.1:9090\n",
        "secret: \"\"\n",
        "\n",
        "dns:\n",
        "  enable: true\n",
        "  ipv6: true\n",
        "  enhanced-mode: fake-ip\n",
        "  fake-ip-filter:\n",
        "    - \"*\"\n",
        "    - \"+.lan\"\n",
        "    - \"+.local\"\n",
        "  nameserver:\n",
        "    - system\n",
        "\n",
        "proxy-providers:\n",
        "  vpn:\n",
        "    type: http\n",
        "    url: \"" + url + "\"\n",
        "    path: ./providers/vpn.yaml\n",
        "    interval: 86400\n",
        "    health-check:\n",
        "      enable: true\n",
        "      url: https://www.gstatic.com/generate_204\n",
        "      interval: 300\n",
        "\n",
        "proxy-groups:\n",
        "  - name: Proxy\n",
        "    type: select\n",
        "    use:\n",
        "      - vpn\n",
        "    proxies:\n",
        "      - DIRECT\n",
        "\n",
        "rules:\n",
        "  - MATCH,Proxy\n",
    ]


def apply_url(url):
    if not url or any(char in url for char in "\r\n\t"):
        raise SystemExit("invalid subscription URL")
    if not os.path.exists(CONFIG):
        write_config(default_config(url))
        return
    with open(CONFIG, encoding="utf-8") as stream:
        lines = stream.readlines()

    in_providers = False
    in_oversub = False
    changed_url = False
    result = []
    for line in lines:
        stripped = line.strip()
        if stripped == "proxy-providers:":
            in_providers = True
        elif in_providers and line and not line[0].isspace():
            in_providers = False
            in_oversub = False
        if in_providers and stripped in ("oversub:", "vpn:"):
            line = line.replace("oversub:", "vpn:")
            in_oversub = True
        elif in_providers and in_oversub and stripped.startswith("url:"):
            indent = line[:len(line) - len(line.lstrip())]
            line = indent + "url: \"" + url + "\"\n"
            changed_url = True
        if stripped == "- oversub":
            line = line.replace("- oversub", "- vpn")
        result.append(line)

    if not changed_url:
        raise SystemExit("provider URL was not found")
    write_config(result)


def set_tun(enabled):
    with open(CONFIG, encoding="utf-8") as stream:
        lines = stream.readlines()

    result = []
    in_tun = False
    changed = False
    for line in lines:
        stripped = line.strip()
        if stripped == "tun:":
            in_tun = True
        elif in_tun and line and not line[0].isspace():
            in_tun = False
        if in_tun and stripped.startswith("enable:"):
            indent = line[:len(line) - len(line.lstrip())]
            line = indent + "enable: " + ("true" if enabled else "false") + "\n"
            changed = True
        result.append(line)

    if not in_tun and not changed and enabled:
        insert_at = next((i + 1 for i, line in enumerate(result) if line.startswith("mixed-port:")), 0)
        result[insert_at:insert_at] = [
            "\n", "tun:\n", "  enable: true\n", "  stack: gVisor\n",
            "  auto-route: true\n", "  auto-detect-interface: true\n"
        ]
    write_config(result)
    if enabled:
        subprocess.run(["setcap", "cap_net_admin,cap_net_raw+ep", "/usr/bin/mihomo"], check=True)


if os.geteuid() != 0:
    raise SystemExit("must be run through pkexec")

if len(sys.argv) < 3:
    raise SystemExit("usage: fuzi-mihomo-admin url URL | tun on|off")

if sys.argv[1] == "url":
    apply_url(sys.argv[2])
elif sys.argv[1] == "tun":
    set_tun(sys.argv[2] == "on")
else:
    raise SystemExit("unknown action")

subprocess.run(["sv", "restart", "mihomo"], check=True)
