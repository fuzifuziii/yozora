#!/bin/bash

wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle >/dev/null

if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED; then
  fuzi-brightness-keyboard-mute on
  fuzi-osd -i microphone-muted -m "Microphone muted"
else
  fuzi-brightness-keyboard-mute off
  fuzi-osd -i microphone -m "Microphone on"
fi
