{
  "bar": {
    "centerAnchor": "fuzi.clock",
    "layout": {
      "left": [
        {
          "id": "fuzi.workspaces"
        }
      ],
      "center": [
        {
          "id": "fuzi.weather"
        },
        {
          "id": "fuzi.clock",
          "format": "dddd HH:mm"
        },
        {
          "id": "fuzi.media"
        }
      ],
      "right": [
        {
          "id": "fuzi.tray"
        },
        {
          "id": "fuzi.keyboard-layout"
        },
        {
          "id": "fuzi.bluetooth"
        },
        {
          "id": "fuzi.network"
        },
        {
          "id": "fuzi.audio"
        },
        {
          "id": "fuzi.system-monitor"
        },
        {
          "id": "fuzi.power"
        },
        {
          "id": "fuzi.dnd"
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "fuzi.file-picker"
    }
  ],
  "version": 1
}
