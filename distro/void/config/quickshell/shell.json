{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "fuzi.clock",
    "layout": {
      "left": [
        { "id": "fuzi.workspaces" }
      ],
      "center": [
        { "id": "fuzi.clock", "format": "dddd HH:mm" }
      ],
      "right": [
        { "id": "fuzi.tray" },
        { "id": "fuzi.keyboard-layout" },
        { "id": "fuzi.bluetooth" },
        { "id": "fuzi.network" },
        { "id": "fuzi.audio" },
        { "id": "fuzi.power" }
      ]
    }
  },
  "plugins": []
}
